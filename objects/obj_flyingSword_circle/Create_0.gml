// Centro do círculo (definido no room creation code)
centro_x = x;
centro_y = y;

// Raio e velocidade angular
raio = 192;       // distância do centro
vel_angular = 2;     // graus por frame (positivo = horário, negativo = anti-horário)

// Ângulo inicial (opcional, pra variar espadas)
angulo = 0;

// Rotação própria do sprite (opcional)
rot_spd = -8;